{
  // Cloudflare Pages project: static files in ./public, the API in
  // functions/api (which hands every /api/* request to src/worker.js).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sauna-finder",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-10-01",
  // Canonical origin for SEO pages, sitemap and social tags. Change this when
  // a custom domain is attached; every other host then gets noindex.
  "vars": { "SITE_URL": "https://sauna-finder.pages.dev" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kiuas",
      "database_id": "4af9d1cd-42c1-4f01-8beb-3f1fe13c2da2",
      "migrations_dir": "migrations"
    }
  ]
  // Secret (set with `wrangler pages secret put INGEST_TOKEN`): bearer token
  // the GitHub Action uses to POST /api/ingest.
}
